# ───── biblioHack — local dev env ─────
# Copy to .env and adjust as needed. Never commit a real .env.

# ───── Postgres ─────
POSTGRES_USER=bibliohack
POSTGRES_PASSWORD=bibliohack
POSTGRES_DB=bibliohack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async URL used by the backend (asyncpg)
DATABASE_URL=postgresql+asyncpg://bibliohack:bibliohack@postgres:5432/bibliohack

# Sync URL used by Alembic (psycopg)
DATABASE_URL_SYNC=postgresql+psycopg://bibliohack:bibliohack@postgres:5432/bibliohack

# ───── Redis ─────
REDIS_URL=redis://redis:6379/0

# ───── FastAPI ─────
APP_ENV=development           # development | test | production
APP_LOG_LEVEL=DEBUG
APP_CORS_ORIGINS=http://localhost:4321

# ───── Scraper ─────
SCRAPER_USER_AGENT=bibliohack/0.1 (+https://github.com/your-user/biblioHack)
SCRAPER_MIN_INTERVAL_SECONDS=1.0
SCRAPER_MAX_INTERVAL_SECONDS=1.8
SCRAPER_DAILY_REQUEST_CAP=30000

# ───── OpenRouter ─────
# Get a key at https://openrouter.ai. Free models are fine for dev.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto:free

# ───── Embeddings ─────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu          # cpu | cuda | mps

# ───── Frontend (Astro) ─────
PUBLIC_API_BASE_URL=http://localhost:8800

# ───── NAS / producción ─────
# IP LAN del NAS. La usan los bindings de Postgres y MinIO en
# docker-compose.prod.yml, para que el worker/embedder de fuera del NAS
# llegue por LAN/Tailscale sin exponer nada a internet.
#
# NO se clava en el compose. Estuvo clavada a 192.168.1.130 hasta el
# 26-08-2026: la DHCP movió el NAS a .131 en algún momento tras el último
# despliegue (16-07-2026) y el siguiente murió al arrancar postgres con
# «bind: cannot assign requested address». Los contenedores se quedaron en
# estado `Created`, que no es `Exited` — el deploy los creó y murió antes de
# arrancarlos.
#
# Sólo hace falta en el .env del NAS; en local no se usa (el compose de
# desarrollo no fija IP). Dale al NAS una reserva DHCP para que esto no
# vuelva a pasar.
NAS_BIND_IP=192.168.1.131

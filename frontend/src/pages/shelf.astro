---
import Layout from "../layouts/Layout.astro";
import { ShelfPage } from "@/components/ShelfPage";

// Static shell; one island handles auth-gating + import + shelf (composed
// inside React — Astro island children are static slots, see ShelfPage).
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8800";
---

<Layout title="biblioHack — mi estantería">
  <section class="space-y-7">
    <header class="space-y-3">
      <h1 class="m-0 font-serif text-[2.6rem] font-bold leading-tight tracking-[-0.025em]">
        Mi estantería
      </h1>
      <p class="m-0 max-w-[46rem] text-[1.05rem] leading-relaxed text-muted-foreground">
        Tu biblioteca de Goodreads, cruzada con el catálogo de la Red de Bibliotecas de Andalucía.
        Los libros encontrados muestran portada y disponibilidad en vivo y enlazan a su ficha; el
        resto se volverá a cruzar a medida que crezca el catálogo.
      </p>
    </header>

    <ShelfPage apiBaseUrl={apiBaseUrl} client:only="react" />
  </section>
</Layout>

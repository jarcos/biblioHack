---
import Layout from "../layouts/Layout.astro";
import { RecommendationsPage } from "@/components/RecommendationsPage";

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8800";
---

<Layout title="biblioHack — recomendaciones">
  <section class="space-y-6">
    <header class="space-y-3">
      <h1 class="m-0 font-serif text-[2.6rem] font-bold leading-tight tracking-[-0.025em]">
        Recomendaciones
      </h1>
      <p class="m-0 max-w-[48rem] text-[1.05rem] leading-relaxed text-muted-foreground">
        Sugerencias del catálogo andaluz a partir de tu estantería: buscamos libros cercanos a los
        que mejor has valorado y que aún no tengas registrados. Se actualizan solas cuando tu
        estantería cambia.
      </p>
    </header>

    <RecommendationsPage apiBaseUrl={apiBaseUrl} client:only="react" />
  </section>
</Layout>

---
import "../styles/global.css";

import Container from "@/components/ui/container.astro";
import { ThemeToggle } from "@/components/ThemeToggle";
import { UserMenu } from "@/components/UserMenu";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Reverse catalog of the Andalusian public libraries." } = Astro.props;
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8800";

// Active nav state — compare against the first path segment so /record etc.
// simply show no active link (they're reachable from Explorar, not nav items).
const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/browse", label: "Explorar" },
  { href: "/shelf", label: "Mi estantería" },
  { href: "/recommendations", label: "Recomendaciones" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {
      /*
        Theme bootstrap — runs synchronously before the body renders so we
        never flash the wrong theme. Reads `localStorage.theme` ("light" |
        "dark" | "system") and falls back to `prefers-color-scheme`.
        Wrapped in is:inline so Astro emits it verbatim with no JS bundle.
        */
    }
    <script is:inline>
      (() => {
        try {
          const stored = window.localStorage.getItem("theme");
          const sysDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const isDark = stored === "dark" || (stored !== "light" && sysDark);
          document.documentElement.classList.toggle("dark", isDark);
        } catch {
          /* ignore — fall back to default light theme */
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground">
    <header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md">
      <Container class="flex h-[66px] items-center justify-between gap-6">
        <a
          href="/"
          class="flex items-baseline gap-px no-underline"
          aria-label="biblioHack — inicio"
        >
          <span class="font-serif text-2xl font-bold tracking-tight text-foreground">biblio</span>
          <span class="font-mono text-xl font-medium tracking-tight text-primary">Hack</span>
        </a>
        <nav class="hidden items-center gap-1 sm:flex" aria-label="Principal">
          {
            navLinks.map(({ href, label }) => (
              <a
                href={href}
                aria-current={currentPath === href ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3.5 py-2 text-[0.95rem] no-underline transition-colors",
                  currentPath === href
                    ? "bg-card font-semibold text-foreground shadow-[inset_0_0_0_1px_hsl(var(--border))]"
                    : "font-medium text-muted-foreground hover:text-foreground",
                ]}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-3.5 text-sm">
          <UserMenu apiBaseUrl={apiBaseUrl} client:only="react" />
          <ThemeToggle client:load />
        </div>
      </Container>
    </header>

    <main class="flex-1 py-12 pb-20">
      <Container>
        <slot />
      </Container>
    </main>

    <footer class="border-t border-border bg-background-2">
      <Container
        class="flex flex-wrap items-center justify-between gap-4 py-7 text-[0.84rem] text-faint"
      >
        <p class="m-0 max-w-[52rem] leading-normal">
          Información obtenida del Portal de la Junta de Andalucía. Datos públicos de la Red de
          Bibliotecas Públicas de Andalucía (CC-BY 3.0 ES). Proyecto personal sin ánimo de lucro.
        </p>
        <div class="flex gap-4">
          <a
            href="https://github.com/jarcos/biblioHack"
            class="text-muted-foreground no-underline transition-colors hover:text-foreground"
          >
            Código
          </a>
          <a
            href="/privacy"
            class="text-muted-foreground no-underline transition-colors hover:text-foreground"
          >
            Privacidad
          </a>
          <a
            href="/terms"
            class="text-muted-foreground no-underline transition-colors hover:text-foreground"
          >
            Condiciones
          </a>
        </div>
      </Container>
    </footer>
  </body>
</html>
